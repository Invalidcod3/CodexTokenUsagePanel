<Window x:Class="CodexMeter.FullStatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Token 明细" Width="1360" Height="860" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#0B0F10" Foreground="#E8ECEA">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="7" CornerRadius="12" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Border x:Name="WindowFrame" CornerRadius="12" BorderBrush="#303A36" BorderThickness="1" Background="#0B0F10" ClipToBounds="True">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border x:Name="TitleBar" Grid.Row="0" Background="#111718" BorderBrush="#26302D" BorderThickness="0,0,0,1" Padding="14,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="26" Height="26" CornerRadius="7" Background="#F1F4F2" Padding="4"><Image x:Name="BrandIcon" Stretch="Uniform"/></Border>
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="Token 明细" FontSize="13" FontWeight="SemiBold"/>
              <TextBlock x:Name="StatusText" Text="正在载入账户与设备统计…" Foreground="#77827D" FontSize="8"/>
            </StackPanel>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="刷新" Width="58" Height="28" Margin="0,0,8,0" VerticalAlignment="Center" Background="#202827" Foreground="#D8DEDB" Click="RefreshButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            <Button Content="—" Width="42" Height="32" VerticalAlignment="Center" Background="Transparent" Foreground="#AAB3AF" FontSize="13" ToolTip="最小化" Click="MinimizeButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            <Button x:Name="MaximizeButton" Content="□" Width="42" Height="32" VerticalAlignment="Center" Background="Transparent" Foreground="#AAB3AF" FontSize="14" ToolTip="最大化" Click="MaximizeButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            <Button Content="×" Width="42" Height="32" VerticalAlignment="Center" Background="Transparent" Foreground="#AAB3AF" FontSize="17" ToolTip="关闭明细窗口" Click="CloseButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
          </StackPanel>
        </Grid>
      </Border>
      <wv2:WebView2 x:Name="Browser" Grid.Row="1" DefaultBackgroundColor="#0B0F10" NavigationCompleted="Browser_NavigationCompleted"/>
    </Grid>
  </Border>
</Window>
