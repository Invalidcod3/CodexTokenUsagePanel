<Window x:Class="CodexMeter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Token Meter" Width="430" Height="790" MinHeight="520"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent" Foreground="#F2F5F3" FontFamily="Segoe UI">
  <Border x:Name="RootSurface" CornerRadius="18" BorderBrush="#303A36" BorderThickness="1" Background="#0D1112" Padding="20">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="30" Height="30" CornerRadius="8" Background="#F1F4F2" Padding="4"><Image x:Name="BrandIcon" Stretch="Uniform"/></Border>
          <StackPanel Margin="10,0,0,0"><TextBlock Text="CODEX METER" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="账户总账 · 本机归因" Foreground="#7E8985" FontSize="9"/></StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Border CornerRadius="9" Background="#14191A" Padding="2" Margin="0,0,8,0">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="AllButton" Content="累计" Width="43" Height="26" Padding="0" Background="#B8FF34" Foreground="#0A0D0B" FontSize="9" Click="AllButton_Click"/>
              <Button x:Name="TodayButton" Content="今日" Width="43" Height="26" Padding="0" Background="Transparent" Foreground="#87918D" FontSize="9" Click="TodayButton_Click"/>
            </StackPanel>
          </Border>
          <Button Content="—" Width="28" Height="28" Padding="0" Background="#171C1D" Foreground="#9DA6A2" FontSize="13" Margin="0,0,5,0" ToolTip="最小化到托盘" Click="MinimizeButton_Click"/>
          <Button Content="×" Width="28" Height="28" Padding="0" Background="#171C1D" Foreground="#9DA6A2" FontSize="17" ToolTip="隐藏到托盘" Click="CloseButton_Click"/>
        </StackPanel>
      </Grid>

      <ScrollViewer Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,5,0">
          <Border x:Name="AccountCard" Padding="18" CornerRadius="12" BorderBrush="#33452E" BorderThickness="1" Background="#131A16">
            <Grid>
              <StackPanel><TextBlock x:Name="AccountScopeLabel" Text="CHATGPT ACCOUNT · LIFETIME" Foreground="#9AA49F" FontSize="9"/><TextBlock x:Name="AccountTotal" Text="正在同步…" Margin="0,11,0,4" FontFamily="Consolas" FontSize="38" FontWeight="Bold"/><TextBlock x:Name="AccountState" Text="读取账户数据" Foreground="#B8FF34" FontSize="9"/></StackPanel>
              <Button x:Name="ExactUsageButton" Content="i" Width="22" Height="22" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#171D1E" Foreground="#9DA6A2" BorderBrush="#46504C" BorderThickness="1" FontFamily="Consolas" FontSize="10" ToolTip="查看精确 Token 总量" Click="ExactUsageButton_Click"/>
              <Popup x:Name="ExactUsagePopup" PlacementTarget="{Binding ElementName=ExactUsageButton}" Placement="Bottom" HorizontalOffset="-286" VerticalOffset="8" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
                <Border Width="340" Padding="18" CornerRadius="12" Background="#151A1B" BorderBrush="#3B4642" BorderThickness="1">
                  <StackPanel>
                    <TextBlock Text="全局 TOKEN 精确用量" Foreground="#F2F5F3" FontSize="11" FontWeight="SemiBold"/>
                    <Border Margin="0,12,0,0" Padding="18,28" Background="#101516" CornerRadius="10" BorderBrush="#33452E" BorderThickness="1">
                      <StackPanel><TextBlock Text="ACCOUNT LIFETIME TOKEN" HorizontalAlignment="Center" Foreground="#77817D" FontFamily="Consolas" FontSize="8"/><TextBlock x:Name="ExactLiveLifetime" Text="—" Margin="0,15,0,0" HorizontalAlignment="Center" Foreground="#B8FF34" FontFamily="Consolas" FontSize="28" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center"/><TextBlock Text="实时累计 · 精确到个位" Margin="0,13,0,0" HorizontalAlignment="Center" Foreground="#68726E" FontSize="8"/></StackPanel>
                    </Border>
                  </StackPanel>
                </Border>
              </Popup>
            </Grid>
          </Border>

          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Padding="11" CornerRadius="9" Background="#14191A"><StackPanel><TextBlock Text="可归因" Foreground="#78827E" FontSize="8"/><TextBlock x:Name="Attributed" Text="—" Margin="0,7,0,0" FontFamily="Consolas" FontSize="15"/></StackPanel></Border>
            <Border Grid.Column="1" Margin="5,0" Padding="11" CornerRadius="9" Background="#1A1715"><StackPanel><TextBlock Text="未归因" Foreground="#9B8171" FontSize="8"/><TextBlock x:Name="Unattributed" Text="—" Margin="0,7,0,0" Foreground="#E0A27E" FontFamily="Consolas" FontSize="15"/></StackPanel></Border>
            <Border Grid.Column="2" Padding="11" CornerRadius="9" Background="#14191A"><StackPanel><TextBlock Text="覆盖率" Foreground="#78827E" FontSize="8"/><TextBlock x:Name="Coverage" Text="—" Margin="0,7,0,0" FontFamily="Consolas" FontSize="15"/></StackPanel></Border>
          </Grid>

          <Grid Margin="0,22,0,9"><TextBlock Text="本机可拆分明细" FontSize="11" FontWeight="SemiBold"/><TextBlock x:Name="LocalMeta" Text="—" HorizontalAlignment="Right" Foreground="#6F7975" FontSize="8"/></Grid>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
            <Border Grid.Row="0" Grid.Column="0" Margin="0,0,4,4" Padding="13" Background="#121718" CornerRadius="9"><StackPanel><TextBlock Text="输入 TOKEN" Foreground="#77817D" FontSize="8"/><TextBlock x:Name="InputTokens" Text="—" Margin="0,7,0,0" FontFamily="Consolas" FontSize="18"/></StackPanel></Border>
            <Border Grid.Row="0" Grid.Column="1" Margin="4,0,0,4" Padding="13" Background="#121718" CornerRadius="9"><StackPanel><TextBlock Text="输出 TOKEN" Foreground="#77817D" FontSize="8"/><TextBlock x:Name="OutputTokens" Text="—" Margin="0,7,0,0" FontFamily="Consolas" FontSize="18"/></StackPanel></Border>
            <Border Grid.Row="1" Grid.Column="0" Margin="0,4,4,0" Padding="13" Background="#121718" CornerRadius="9"><StackPanel><TextBlock Text="缓存输入" Foreground="#77817D" FontSize="8"/><TextBlock x:Name="CachedTokens" Text="—" Margin="0,7,0,0" Foreground="#B8FF34" FontFamily="Consolas" FontSize="18"/></StackPanel></Border>
            <Border Grid.Row="1" Grid.Column="1" Margin="4,4,0,0" Padding="13" Background="#121718" CornerRadius="9"><StackPanel><TextBlock Text="推理输出" Foreground="#77817D" FontSize="8"/><TextBlock x:Name="ReasoningTokens" Text="—" Margin="0,7,0,0" FontFamily="Consolas" FontSize="18"/></StackPanel></Border>
          </Grid>

          <Border Margin="0,12,0,0" Padding="14" Background="#101516" CornerRadius="9"><Grid><StackPanel><TextBlock Text="本机 API 等价费用" Foreground="#7D8783" FontSize="8"/><TextBlock Text="账户全量外推（非账单）" Foreground="#59625F" FontSize="8" Margin="0,7,0,0"/></StackPanel><StackPanel HorizontalAlignment="Right"><TextBlock x:Name="LocalCost" Text="—" Foreground="#B8FF34" FontFamily="Consolas" FontSize="18" HorizontalAlignment="Right"/><TextBlock x:Name="ProjectedCost" Text="—" Foreground="#A0A9A5" FontFamily="Consolas" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Right"/></StackPanel></Grid></Border>

          <TextBlock Text="Codex 额度窗口" Margin="0,16,0,7" Foreground="#7C8682" FontSize="8"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Margin="0,0,4,0" Padding="11" Background="#121718" CornerRadius="8"><StackPanel><Grid><TextBlock x:Name="PrimaryLimitLabel" Text="主要窗口" Foreground="#8C9691" FontSize="8"/><TextBlock x:Name="PrimaryLimitValue" Text="—" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="9"/></Grid><ProgressBar x:Name="PrimaryLimitBar" Height="4" Margin="0,8,0,6" Maximum="100" Background="#252C2A" Foreground="#B8FF34" BorderThickness="0"/><TextBlock x:Name="PrimaryReset" Text="重置 —" Foreground="#626B67" FontSize="7"/></StackPanel></Border>
            <Border Grid.Column="1" Margin="4,0,0,0" Padding="11" Background="#121718" CornerRadius="8"><StackPanel><Grid><TextBlock x:Name="SecondaryLimitLabel" Text="次要窗口" Foreground="#8C9691" FontSize="8"/><TextBlock x:Name="SecondaryLimitValue" Text="—" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="9"/></Grid><ProgressBar x:Name="SecondaryLimitBar" Height="4" Margin="0,8,0,6" Maximum="100" Background="#252C2A" Foreground="#8BC7FF" BorderThickness="0"/><TextBlock x:Name="SecondaryReset" Text="重置 —" Foreground="#626B67" FontSize="7"/></StackPanel></Border>
          </Grid>
          <TextBlock Text="模型排行" Margin="0,16,0,7" Foreground="#7C8682" FontSize="8"/>
          <Border Padding="11" Background="#121718" CornerRadius="8"><TextBlock x:Name="TopModels" Text="—" Foreground="#A6AFAB" FontFamily="Consolas" FontSize="9" TextWrapping="Wrap" LineHeight="16"/></Border>
        </StackPanel>
      </ScrollViewer>

      <Grid Grid.Row="2" Margin="0,14,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="132"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
        <Button x:Name="DashboardOpenButton" Grid.Column="0" Content="打开完整统计" Height="36" Margin="0,0,8,0" Background="#B8FF34" Foreground="#0A0D0B" FontWeight="SemiBold" Click="DashboardButton_Click"/>
        <ComboBox x:Name="PeriodPicker" Grid.Column="1" Height="36" Margin="0,0,8,0" Style="{StaticResource MeterComboBox}" SelectionChanged="PeriodPicker_SelectionChanged"/>
        <Button Grid.Column="2" Content="刷新" Height="36" Background="#171D1E" Foreground="#BFC7C3" Click="RefreshButton_Click"/>
      </Grid>
      <TextBlock Grid.Row="3" x:Name="StatusText" Text="准备同步" Margin="0,11,0,0" Foreground="#626C68" FontSize="8" TextTrimming="CharacterEllipsis"/>
    </Grid>
  </Border>
</Window>
